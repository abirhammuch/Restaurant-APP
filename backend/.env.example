# Backend Environment Variables Template
# Copy this to .env and fill in your values
# For production (Vercel), set these in: Vercel Dashboard → Settings → Environment Variables

# ============ MongoDB ============
MONGODB_URI=your_mongodb_connection_string

# ============ Cloudinary ============
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ============ JWT ============
JWT_SECRET=your_jwt_secret_key

# ============ Chapa Payment Gateway (IMPORTANT!) ============
# Get these from: https://dashboard.chapa.co → Settings → API Keys
CHAPA_SECRET_KEY=your_chapa_secret_key_here
CHAPA_PUBLIC_KEY=your_chapa_public_key_here

# ============ URLs (IMPORTANT for Chapa!) ============
# For local: http://localhost:3000 and http://localhost:5173
# For production: Your actual Vercel domain URLs
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ============ Node Environment ============
NODE_ENV=development

# ============ SMTP password reset email ============
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_password_or_app_password
SMTP_FROM=your_email@example.com

# ============ PRODUCTION NOTES ============
# When deploying to Vercel:
# 1. Set BACKEND_URL to your backend Vercel URL (e.g., https://your-backend.vercel.app)
# 2. Set FRONTEND_URL to your frontend Vercel URL (e.g., https://your-frontend.vercel.app)
# 3. Ensure CHAPA_SECRET_KEY is set correctly (no extra spaces)
# 4. Test the /api/chapa/initiate endpoint after deployment
# See CHAPA_VERCEL_TROUBLESHOOTING.md for deployment help

